# Development branch only; never commit real credentials.
NUXT_DATABASE_URL=postgresql://USER:PASSWORD@ENDPOINT-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ENDPOINT.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
NUXT_RATE_LIMIT_SECRET=replace-with-a-random-secret-at-least-32-characters
NUXT_ALLOWED_ORIGIN=http://localhost:3000
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_PREVIEW=true
# Required before accepting public production signups.
NUXT_TURNSTILE_SECRET=
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
# Only true behind a host that strips and supplies trusted X-Forwarded-For.
NUXT_TRUST_PROXY=false
